# Copy to .dev.vars (gitignored) for local development.
# For production, use: wrangler secret put --env <staging|production> <NAME>

# Core agent
ANTHROPIC_API_KEY=sk-ant-...

# Voice — provider is swappable at runtime.
# OpenAI uses OPENAI_API_KEY server-side only to mint ephemeral client_secret
# tokens for the browser. Gemini Live uses GOOGLE_GEMINI_API_KEY server-side
# to mint short-lived auth tokens for the browser.
VOICE_PROVIDER=openai-realtime
VOICE_MODEL=gpt-realtime
VOICE_VOICE=marin
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_LIVE_VOICE=Kore

# Async push-to-talk voice commands. This path records in the browser, sends
# audio to a local Whisper sidecar, interprets the transcript, then reuses the
# existing canvas generation flow. Unset LOCAL_WHISPER_URL to disable it
# gracefully.
LOCAL_WHISPER_URL=http://127.0.0.1:9000/transcribe
LOCAL_WHISPER_TOKEN=
# Apple Silicon uses MLX/Metal by default; Linux/CUDA can use faster-whisper.
LOCAL_WHISPER_BACKEND=mlx
LOCAL_WHISPER_MODEL=mlx-community/whisper-small-mlx
# Optional command planner. Default behavior is heuristic parsing; set this to
# deepseek to use the official DeepSeek API for transcript intent parsing.
AETHER_COMMAND_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AETHER_COMMAND_MODEL=deepseek-v4-flash

# Optional local embedding / CLIP reranker for voice reference searches.
# The endpoint receives { query, imageUrls, limit } and returns either
# { ranked: [{ url, score }] } or { urls: [...] }. Search itself still uses
# SERPAPI_KEY when configured, then this local model reorders the candidates.
SERPAPI_KEY=
LOCAL_EMBEDDING_RERANK_URL=http://127.0.0.1:8002/rerank
# Can reuse CLIP_MODAL_TOKEN for the local /rerank server.
LOCAL_EMBEDDING_TOKEN=

# Image gen providers (pick any subset — provider is selected at runtime)
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=...
REPLICATE_API_TOKEN=r8_...
VOLCENGINE_ARK_API_KEY=...

# Local all-in-one stack:
#   npm run dev:local
# Starts local Convex, Next, and the local Whisper/SAM3/CLIP sidecars.
# Set AETHER_SKIP_LOCAL_MODELS=1 to run only Convex + Next.

# Segmentation providers
# `sam2` uses REPLICATE_API_TOKEN.
# `sam3` expects an external HTTP endpoint, typically a Modal web endpoint.
SAM3_MODAL_URL=https://<workspace>--<label>.modal.run
SAM3_MODAL_TOKEN=
# Optional default provider when more than one is connected.
SEGMENTATION_PROVIDER=sam3

# Clustering provider — CLIP embeddings + HDBSCAN + UMAP via Modal.
# Both vars are required. Endpoint fails closed when the token is unset.
# See docs/CLIP-MODAL.md.
CLIP_MODAL_URL=https://<workspace>--aether-clip-cluster.modal.run
CLIP_MODAL_TOKEN=

# Research signals — uses the same env names as the Tong signal pipeline, but
# the implementation is self-contained in aether. Instagram prefers Apify;
# XHS prefers RapidAPI; TikTok uses public search and degrades quietly.
SIGNALS_EXECUTION_MODE=live
SIGNALS_SCRAPER_INSTAGRAM=apify
SIGNALS_XHS_PROVIDERS=rapidapi
SIGNALS_XHS_RETRIES=4
APIFY_API_TOKEN=
RAPIDAPI_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Spatial (gaussian splat / particle field) providers.
# `draft` is always available and renders a local SVG preview — no keys needed.
# `replicate-splat` uses REPLICATE_API_TOKEN (model: jd7h/splatter-image by default).
# `modal-splat` expects an external HTTP endpoint (see docs/SAM3-MODAL.md for the pattern).
SPATIAL_REPLICATE_VERSION=
SPATIAL_MODAL_URL=https://<workspace>--splat.modal.run
SPATIAL_MODAL_TOKEN=
# Optional default provider for the spatial seam. If unset, the factory
# prefers real providers over `draft` when their keys are present.
SPATIAL_PROVIDER=draft

# Publisher providers.
# `preview` is always available. `postiz` schedules Western channels through a
# self-hosted Postiz instance; `social-auto-upload` schedules CJK/browser-
# automation channels through the Python sidecar in sidecars/social-auto-upload.
#
# Local default — preview only (no real posting).
PUBLISHER_PROVIDER=preview
# Keep unset/preview for local preview-only UI. Set to `server` in deployments
# where the right rail should call /api/publish and reach configured sidecars.
NEXT_PUBLIC_PUBLISHER_MODE=preview
# Postiz — set these to enable real Western-channel scheduling.
POSTIZ_API_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
# Per-platform integration IDs from your Postiz account.
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_TIKTOK=
POSTIZ_INTEGRATION_X=
POSTIZ_INTEGRATION_LINKEDIN=
POSTIZ_INTEGRATION_YOUTUBE_SHORTS=
POSTIZ_INTEGRATION_PINTEREST=
POSTIZ_PINTEREST_BOARD_ID=
POSTIZ_PINTEREST_LINK_URL=
# CJK/browser-automation sidecar.
SOCIAL_AUTO_UPLOAD_URL=http://127.0.0.1:8891
SOCIAL_AUTO_UPLOAD_TOKEN=

# Convex — set after `npx convex dev` creates a project
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_DEPLOY_KEY=...

# social-auto-upload sidecar (Modal) — CJK platforms: TikTok/Douyin/XHS/Bilibili/Kuaishou.
# Deploy with: modal deploy infra/social-auto-upload/modal_app.py
# See docs/DEPLOY-PUBLISHERS.md for cookie-capture instructions.
SOCIAL_AUTO_UPLOAD_URL=https://<workspace>--aether-sau-aether-sau.modal.run
SOCIAL_AUTO_UPLOAD_TOKEN=

# App
AETHER_ENV=development
NEXTJS_ENV=development

# Route-human (Discord review gate) — see docs/DISCORD-SETUP.md.
# DISCORD_WEBHOOK_URL: where the reviewer agent posts ready-for-ernie cards.
# Fail-closed: if unset, sendReviewNotification throws and the CI job fails
# visibly so reviews are never silently dropped.
DISCORD_WEBHOOK_URL=
# DISCORD_PUBLIC_KEY: hex-encoded Ed25519 public key from the Discord app
# page. Used by the interaction route to verify every incoming request.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Token the interaction route uses to merge / label / close / comment in
# response to button presses. CLAUDE_CODE_OAUTH_TOKEN is used when set;
# override with GITHUB_MERGE_TOKEN if you need a different scope.
GITHUB_MERGE_TOKEN=
# "owner/repo" — the repo the interaction route is authorized to act on.
GITHUB_REPOSITORY=erniesg/aether

# X (Twitter) Account Activity API webhook receiver — app/api/webhooks/x/route.ts
# Generate at: developer.twitter.com → Project → App → Keys and Tokens → Consumer Keys
# Required in production; omit in dev (route accepts without verification when AETHER_ENV=development).
X_WEBHOOK_CONSUMER_SECRET=
